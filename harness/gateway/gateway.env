# Live gateway settings shared by every script in this directory (docs/demo_tasks.md §3).
# DESIGN GAP: G2's Python launcher needs the switch-facing names below; task C1 decides whether
# they move into common/contracts.py with the live_gateway topology.

AAN_NETNS=aan-lan
AAN_WG_IF=wg0
AAN_WG_PORT=51820
AAN_WG_ADDR=10.42.0.1/24
AAN_CLIENT_NET=10.42.0.0/24
AAN_CLIENT_FIRST=10
AAN_CLIENT_LAST=250
AAN_SELFTEST_HOST=254
AAN_CLIENT_DNS="1.1.1.1, 8.8.8.8"
# Tunnel MTU: 1280 inner + 80 WireGuard overhead fits the 1460-byte GCE uplink and cellular paths.
AAN_MTU=1280

# Client side: AAN_LAN_IF lives in the netns; AAN_LAN_SW is the switch's LAN port.
AAN_LAN_IF=gw-lan
AAN_LAN_SW=gw-lan-sw
AAN_LAN_ADDR=10.43.0.2/30
# Internet side: AAN_WAN_SW is the switch's WAN port; AAN_WAN_IF routes and NATs to the uplink.
AAN_WAN_IF=gw-wan
AAN_WAN_SW=gw-wan-sw
AAN_WAN_ADDR=10.43.0.1/30
AAN_BYPASS_BR=br-bypass

AAN_STATE_DIR=/etc/aan-gateway
AAN_LIB_DIR=/usr/local/lib/aan-gateway
